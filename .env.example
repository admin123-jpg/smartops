# ============================================================
# SmartOps Assistant 配置模板
# 用法：复制为 .env 后按需修改。所有项都有默认值，不配也能跑。
# ============================================================

# ---------------- 基础 ----------------
DEBUG=true
HOST=127.0.0.1
PORT=8100

# ---------------- 数据库 ----------------
# 本地开发默认 SQLite（零依赖）；生产用 MySQL，取消下面一行注释即可
# DATABASE_URL=mysql+pymysql://smartops:smartops@127.0.0.1:3306/smartops?charset=utf8mb4

# ---------------- Redis / Celery ----------------
# Redis 不可用时 Celery 自动切到 eager（同步）模式，功能不变但失去异步性
REDIS_URL=redis://127.0.0.1:6379/0

# ---------------- 认证 ----------------
JWT_SECRET=please-change-this-in-production
JWT_EXPIRE_MINUTES=720

# ---------------- SSH ----------------
SSH_TIMEOUT=10
SSH_MAX_CONCURRENCY=10

# ---------------- 巡检阈值 ----------------
INSPECT_DISK_WARN=80
INSPECT_DISK_CRIT=90
INSPECT_MEM_WARN=85
INSPECT_LOAD_WARN=4

# ---------------- 大模型（AI 智能诊断）----------------
# 不配 LLM_API_KEY 也能跑：AI 诊断会自动降级为内置规则库，用 mode 字段标识来源
# DeepSeek:  LLM_BASE_URL=https://api.deepseek.com          LLM_MODEL=deepseek-chat
# 通义千问:  LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   LLM_MODEL=qwen-plus
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60
LLM_MAX_TOKENS=1200

# ---------------- 告警 ----------------
# 去重窗口（秒）：同主机+同指标+同告警名 在此窗口内只通知一次
ALERT_DEDUP_WINDOW=300
# Alertmanager 里配的 bearer_token，留空则不校验（仅本地调试）
ALERT_WEBHOOK_TOKEN=

# 通知渠道（留空则只落库不发送）
DINGTALK_WEBHOOK=
FEISHU_WEBHOOK=
WECOM_WEBHOOK=

# ---------------- CI/CD（不配则整块能力优雅关闭）----------------
GITLAB_BASE_URL=
GITLAB_TOKEN=
GITLAB_PROJECT=
JENKINS_BASE_URL=
JENKINS_USER=
JENKINS_TOKEN=
